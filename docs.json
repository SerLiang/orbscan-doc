{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Orbscan",
  "theme": "mint",
  "colors": {
    "primary": "#0F57FF",
    "light": "#5082F7",
    "dark": "#0C46CC"
  },
  "favicon": {
    "light": "/images/logo-symbol.svg",
    "dark": "/images/logo-symbol-light.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Visit Orbscan",
      "href": "https://orbscan.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/OrbscanHQ"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "auth": {
        "method": "bearer",
        "name": "your_api_key"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index",
              "quickstart",
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/endpoints/get-wallet-address",
              "api-reference/endpoints/get-portfolio",
              "api-reference/endpoints/get-open-positions",
              "api-reference/endpoints/get-closed-positions",
              "api-reference/endpoints/get-combo-open-positions",
              "api-reference/endpoints/get-combo-closed-positions",
              "api-reference/endpoints/get-trader-activity",
              "api-reference/endpoints/get-rewards",
              "api-reference/endpoints/get-deposits-withdrawals",
              "api-reference/endpoints/get-transaction"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo-light.svg",
    "href": "https://orbscan.com"
  },
  "background": {
    "color": {
      "dark": "#0A0B10"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  }
}
