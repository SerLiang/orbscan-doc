            "pages": [
              "concepts/traders",
              "concepts/markets",
              "concepts/pnl-metrics"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/fetch-trader-profile",
              "guides/leaderboard",
              "guides/copy-trading",
              "guides/market-activity"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/errors",
              "api-reference/rate-limits"
            ]
          },
          {
            "group": "Traders",
            "pages": [
