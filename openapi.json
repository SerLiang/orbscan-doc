  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Pass your Orbscan API key in the `apikey` request header."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The API key is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": { "type": "string", "example": "Missing or invalid API key" },
                "status_code": { "type": "string", "example": "401" },
                "data": { "type": "null" }
              }
            },
            "example": {
              "message": "Missing or invalid API key",
              "status_code": "401",
              "data": null
            }
          }
        }
      }
    },
    "schemas": {
      "ActivityItem": {
        "type": "object",
        "properties": {
          "blockTimestamp": { "type": "integer", "format": "int64", "description": "Unix timestamp (seconds) of the action." },
          "actionType": { "type": "string", "description": "Action label.", "example": "Buy", "enum": ["Buy", "Sell", "Redeem"] },
          "price": { "type": "string", "description": "Price per share as a decimal (0–1). Multiply by 100 to get cents.", "example": "0.78" },
          "size": { "type": "string", "description": "Number of shares.", "example": "5" },
          "fee": { "type": "string", "description": "Fee charged, in USDC.", "example": "0.02574" },
          "usdcSize": { "type": "string", "description": "Gross USDC value of the action.", "example": "3.9" },
          "netSharesTransferred": { "type": "string", "description": "Net shares transferred (positive = received, negative = sent).", "example": "5" },
          "txHash": { "type": "string", "description": "On-chain transaction hash." },
          "tokenId": { "type": "string", "description": "Polymarket outcome token ID." },
          "marketId": { "type": "string" },
          "marketSlug": { "type": "string" },
          "eventSlug": { "type": "string" },
          "conditionId": { "type": "string" },
          "marketTitle": { "type": "string" },
          "positionSide": { "type": "string", "description": "Which outcome the trade is on.", "example": "Yes" },
          "outcomeIndex": { "type": "integer", "example": 0 },
          "logo": { "type": "string", "description": "Market logo URL." },
          "traderAddress": { "type": "string", "description": "The queried wallet address." },
          "liquidityRole": { "type": "string", "nullable": true, "description": "MAKER or TAKER, or null for non-trade actions such as redeems.", "example": "TAKER", "enum": ["MAKER", "TAKER", null] }
        }
      },
      "TransferItem": {
        "type": "object",
        "properties": {
          "txHash": { "type": "string", "description": "On-chain transaction hash." },
          "type": { "type": "string", "description": "Transfer direction.", "example": "deposit", "enum": ["deposit", "withdrawal"] },
          "amount": { "type": "string", "description": "USDC amount transferred.", "example": "181038.379452" },
          "blockTimestamp": { "type": "integer", "format": "int64", "description": "Unix timestamp (seconds)." },
          "address": { "type": "string", "description": "Counterparty address. For deposits this may be the zero address when funds are bridged in." }
        }
      },
      "TransactionAction": {
        "type": "object",
        "properties": {
          "actionType": { "type": "string", "example": "Buy" },
          "tokenId": { "type": "string", "description": "Polymarket outcome token ID involved in this fill." },
          "size": { "type": "string", "description": "Number of shares in this fill." },
          "price": { "type": "string", "description": "Price per share as a decimal (0–1).", "example": "0.983782" },
          "usdcSize": { "type": "string", "description": "USDC value of this fill." },
          "traderAddress": { "type": "string", "description": "Address that performed this fill." },
          "txHash": { "type": "string" },
          "blockTimestamp": { "type": "integer", "format": "int64" },
          "fee": { "type": "string" },
          "marketId": { "type": "string" },
          "marketSlug": { "type": "string" },
          "eventSlug": { "type": "string" },
          "marketTitle": { "type": "string" },
          "positionSide": { "type": "string", "example": "No" },
          "outcomeIndex": { "type": "integer", "example": 1 },
          "logo": { "type": "string", "description": "Market logo URL." },
          "liquidityRole": { "type": "string", "nullable": true, "example": "TAKER", "enum": ["MAKER", "TAKER", null] }
        }
      },
      "TransactionDetail": {
        "type": "object",
        "properties": {
          "txHash": { "type": "string" },
          "blockNumber": { "type": "integer", "format": "int64" },
          "blockTimestamp": { "type": "integer", "format": "int64" },
          "traderAddress": { "type": "string", "description": "The primary wallet this transaction is attributed to." },
          "sourceType": { "type": "string", "example": "TRADE" },
          "actionType": { "type": "string", "description": "Top-level action for the transaction.", "example": "Buy" },
          "sentence": { "type": "string", "description": "Plain-English summary of the transaction.", "example": "Buy 3604.58 No for $3546.12269 in Will Bitcoin dip to $59,000 on June 9?" },
          "marketSlug": { "type": "string" },
          "marketId": { "type": "string" },
          "actions": {
            "type": "array",
            "description": "Every individual on-chain fill contained in this transaction.",
            "items": { "$ref": "#/components/schemas/TransactionAction" }
          },
          "comboActions": {
            "type": "array",
            "nullable": true,
            "description": "Combined actions for multi-leg trades, or null when not applicable.",
            "items": { "type": "object" }
          }
        }
      },
      "OpenPosition": {
        "type": "object",
        "properties": {
          "marketId": { "type": "string" },
          "marketSlug": { "type": "string" },
          "eventSlug": { "type": "string" },
          "conditionId": { "type": "string" },
          "marketTitle": { "type": "string" },
          "logo": { "type": "string", "description": "Market logo URL." },
          "closed": { "type": "boolean", "description": "Whether the market has closed." },
          "tokenId": { "type": "string", "description": "Polymarket outcome token ID." },
          "positionSide": { "type": "string", "description": "Which outcome is held.", "example": "Yes" },
          "outcomeIndex": { "type": "integer", "example": 0 },
          "balance": { "type": "string", "description": "Current token balance (shares held)." },
          "avgPrice": { "type": "string", "description": "Volume-weighted average entry price as a decimal (0–1)." },
          "currentPrice": { "type": "string", "description": "Current market price as a decimal (0–1)." },
          "avgExit": { "type": "string", "description": "Volume-weighted average exit price, or \"0\" if no exits yet." },
          "totalInvested": { "type": "string", "description": "Total USDC spent on this position." },
          "totalBought": { "type": "string", "description": "Total shares purchased (before any sells)." },
          "value": { "type": "string", "description": "Current mark-to-market value in USDC (balance × currentPrice)." },
          "unrealizedPnl": { "type": "string", "description": "Unrealized profit/loss in USDC." },
          "realizedPnl": { "type": "string", "description": "Realized profit/loss in USDC from any sells." },
          "totalPnl": { "type": "string", "description": "Total PnL (unrealized + realized) in USDC." },
          "percentPnl": { "type": "string", "description": "Total PnL as a percentage of total invested." },
          "closedAt": { "type": "integer", "format": "int64", "nullable": true, "description": "Unix timestamp when the market resolved, or null if still open." }
        }
      },
      "ComboLeg": {
        "type": "object",
        "properties": {
          "comboPositionId": { "type": "string" },
          "legIndex": { "type": "integer", "description": "Zero-based index of this leg within the combo." },
          "legPositionId": { "type": "string" },
          "marketId": { "type": "string" },
          "marketTitle": { "type": "string" },
          "logo": { "type": "string" },
          "marketSlug": { "type": "string" },
          "eventSlug": { "type": "string" },
          "outcomeIndex": { "type": "integer" },
          "outcome": { "type": "string", "description": "Outcome label for this leg.", "example": "Yes" },
          "outcomePrice": { "type": "string", "description": "Current price of this leg's outcome as a decimal (0–1)." },
          "resolved": { "type": "boolean", "description": "Whether this leg has resolved." }
        }
      },
      "ComboPosition": {
        "type": "object",
        "properties": {
          "comboPositionId": { "type": "string", "description": "Unique identifier for the combo position." },
          "comboConditionId": { "type": "string" },
          "amount": { "type": "string", "description": "Number of combo shares held." },
          "avgPrice": { "type": "string", "description": "Volume-weighted average entry price as a decimal (0–1)." },
          "realizedPnl": { "type": "string", "description": "Realized profit/loss in USDC." },
          "totalBought": { "type": "string", "description": "Total combo shares purchased." },
          "balance": { "type": "string", "description": "Current balance of combo shares." },
          "balanceTimestamp": { "type": "integer", "format": "int64", "description": "Unix timestamp of the last balance update." },
          "totalFee": { "type": "string", "description": "Total fees paid in USDC." },
          "recentTradeTime": { "type": "integer", "format": "int64", "description": "Unix timestamp of the most recent trade." },
          "firstTradeTime": { "type": "integer", "format": "int64", "description": "Unix timestamp of the first trade." },
          "currentPrice": { "type": "string", "description": "Current combo price as a decimal (0–1), calculated from all legs." },
          "unrealizedPnl": { "type": "string", "description": "Unrealized profit/loss in USDC." },
          "totalPnl": { "type": "string", "description": "Total PnL (unrealized + realized) in USDC." },
          "percentPnl": { "type": "string", "description": "Total PnL as a percentage of total invested." },
          "legs": {
            "type": "array",
            "description": "Individual market legs that make up this combo position.",
            "items": { "$ref": "#/components/schemas/ComboLeg" }
          }
        }
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "positionValue": { "type": "string", "description": "Total mark-to-market value of all open positions in USDC." },
          "usdBalance": { "type": "string", "description": "Uninvested USDC balance in the wallet." },
          "portfolioValue": { "type": "string", "description": "Combined portfolio value: positionValue + usdBalance." }
        }
      }
    }
  }
}
